# NVIDIA NIM API Key - get yours from https://build.nvidia.com
NVIDIA_NIM_API_KEY=
NVIDIA_NIM_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_NIM_DEFAULT_MODEL=meta/llama-3.1-8b-instruct

# Local Ollama-compatible server (LM Studio, llama.cpp, vLLM, etc.)
LOCAL_BASE_URL=http://localhost:11434/v1
LOCAL_API_KEY=
LOCAL_DEFAULT_MODEL=llama3.1:8b

PREFER_LOCAL=true

# Emma bridge integration
EMMA_API_URL=http://localhost:8000
EMMA_API_KEY=